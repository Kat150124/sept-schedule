  <script>
    (() => {
      const state = {
        records: [],
        editingId: null,
        deleteCandidateId: null,
        ready: false
      };

      const form = document.getElementById("note-form");
      const dateInput = document.getElementById("note-date");
      const activityInput = document.getElementById("note-activity");
      const statusInput = document.getElementById("note-status");
      const feelingInput = document.getElementById("note-feeling");
      const remarksInput = document.getElementById("note-remarks");
      const saveButton = document.getElementById("save-button");
      const cancelButton = document.getElementById("cancel-button");
      const message = document.getElementById("form-message");
      const list = document.getElementById("notes-list");
      const emptyState = document.getElementById("empty-state");
      const recordCount = document.getElementById("record-count");

      function setMessage(text, isError = false) {
        message.textContent = text;
        message.classList.toggle("error", isError);
      }

      function setSaving(isSaving) {
        saveButton.disabled = isSaving;
        cancelButton.disabled = isSaving;
        saveButton.querySelector("svg")?.classList.toggle("animate-pulse", isSaving);
      }

      function sortRecords(records) {
        return [...records].sort((a, b) => {
          const byDate = String(b.date).localeCompare(String(a.date));
          return byDate || String(b.created_at).localeCompare(String(a.created_at));
        });
      }

      function updateCard(card, record) {
        card.dataset.recordId = record.__backendId;
        card.dataset.status = record.status;
        card.querySelector(".note-date").textContent = record.date;
        card.querySelector('[data-template-id="note-status-tag"]').textContent = record.status;
        card.querySelector(".note-activity").textContent = record.activity;
        card.querySelector(".note-feeling").textContent = record.body_feeling;
        const remarks = card.querySelector(".note-remarks");
        const remarksWrap = card.querySelector(".note-remarks-wrap");
        remarks.textContent = record.notes || "—";
        remarksWrap.hidden = false;
      }

      function makeCard(record) {
        const fragment = document.getElementById("note-card-template").content.cloneNode(true);
        const card = fragment.querySelector("article");
        updateCard(card, record);

        card.querySelector(".edit-action").addEventListener("click", () => beginEdit(record.__backendId));
        card.querySelector(".delete-action").addEventListener("click", (event) => requestDelete(record.__backendId, event.currentTarget));

        return card;
      }

      function render(records) {
        state.records = sortRecords(records);
        recordCount.textContent = String(state.records.length);
        emptyState.classList.toggle("hidden", state.records.length !== 0);

        const existing = new Map([...list.children].map(card => [card.dataset.recordId, card]));
        state.records.forEach(record => {
          const existingCard = existing.get(record.__backendId);
          if (existingCard) {
            updateCard(existingCard, record);
            existing.delete(record.__backendId);
          } else {
            list.appendChild(makeCard(record));
          }
        });
        existing.forEach(card => card.remove());
      }

      function resetForm() {
        form.reset();
        state.editingId = null;
        cancelButton.classList.add("hidden");
        setMessage("");
      }

      function beginEdit(id) {
        const record = state.records.find(item => item.__backendId === id);
        if (!record) return;

        state.editingId = id;
        dateInput.value = record.date;
        activityInput.value = record.activity;
        statusInput.value = record.status;
        feelingInput.value = record.body_feeling;
        remarksInput.value = record.notes || "";
        cancelButton.classList.remove("hidden");
        setMessage("正在編輯此筆筆記。");
        form.scrollIntoView({ behavior: "smooth", block: "start" });
        activityInput.focus();
      }

      async function requestDelete(id, button) {
        if (!state.ready) return;

        if (state.deleteCandidateId !== id) {
          document.querySelectorAll(".delete-action.is-confirming").forEach(item => {
            item.classList.remove("is-confirming");
            item.setAttribute("aria-label", "刪除此筆記");
          });
          state.deleteCandidateId = id;
          button.classList.add("is-confirming");
          button.setAttribute("aria-label", "再次點擊以確認刪除");
          setMessage("再次點擊紅色刪除按鈕以確認刪除。", true);
          return;
        }

        const record = state.records.find(item => item.__backendId === id);
        if (!record) return;

        button.disabled = true;
        setMessage("正在刪除筆記…");
        const result = await window.dataSdk.delete(record);
        if (!result.isOk) {
          button.disabled = false;
          setMessage("刪除失敗，請稍後再試。", true);
          return;
        }

        state.deleteCandidateId = null;
        setMessage("筆記已刪除。");
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!state.ready) {
          setMessage("資料尚在準備中，請稍候。", true);
          return;
        }

        if (!form.reportValidity()) return;

        const payload = {
          date: dateInput.value,
          activity: activityInput.value.trim(),
          status: statusInput.value,
          body_feeling: feelingInput.value.trim(),
          notes: remarksInput.value.trim(),
          created_at: new Date().toISOString()
        };

        setSaving(true);
        setMessage(state.editingId ? "正在更新筆記…" : "正在儲存筆記…");

        let result;
        if (state.editingId) {
          const existing = state.records.find(item => item.__backendId === state.editingId);
          result = existing ? await window.dataSdk.update({ ...existing, ...payload, created_at: existing.created_at }) : null;
        } else {
          if (state.records.length >= 999) {
            setSaving(false);
            setMessage("已達 999 筆筆記上限，請先刪除不需要的紀錄。", true);
            return;
          }
          result = await window.dataSdk.create(payload);
        }

        setSaving(false);
        if (!result || !result.isOk) {
          setMessage("儲存失敗，請檢查後再試一次。", true);
          return;
        }

        const wasEditing = Boolean(state.editingId);
        resetForm();
        setMessage(wasEditing ? "筆記已更新。" : "筆記已加入。");
      });

      cancelButton.addEventListener("click", resetForm);

      const handler = {
        onDataChanged(data) {
          render(data);
        }
      };

      async function initialise() {
        const result = await window.dataSdk.init(handler);
        if (!result.isOk) {
          setMessage("目前無法載入筆記，請稍後重新開啟頁面。", true);
          return;
        }
        state.ready = true;
      }

      document.addEventListener("DOMContentLoaded", () => {
        lucide.createIcons();
        initialise();
      });
    })();
  </script>
 
</body></html>
